# GRUDGE broker configuration. Copy to broker/.env. Never commit .env.
#
# Wallets come from app.virtuals.io -> your agent -> Signers -> + Add Signer.
# The signer key is Privy's base64 PKCS#8 P-256 key (starts with MIGH), NOT a hex EOA key.
# Buyer, second buyer and sandbox provider MUST be three different wallets.

# Broker A: the buyer whose grudges we build first
BROKER_A_WALLET_ADDRESS=0x
BROKER_A_WALLET_ID=
BROKER_A_SIGNER_PRIVATE_KEY=

# Broker B: a second buyer, separate process, never meets the provider directly
BROKER_B_WALLET_ADDRESS=0x
BROKER_B_WALLET_ID=
BROKER_B_SIGNER_PRIVATE_KEY=

# Sandbox provider: our own seller, registered on the Service Registry with one offering.
# PROVIDER_MODE=burn makes it miss the spec on purpose (the demo's session 1).
PROVIDER_WALLET_ADDRESS=0x
PROVIDER_WALLET_ID=
PROVIDER_SIGNER_PRIVATE_KEY=
PROVIDER_OFFERING_NAME=GRUDGE Research
# If the provider has no registered offering the broker uses a raw ACP createJob instead.
PROVIDER_MODE=burn

# 8453 = Base mainnet. Base Sepolia (84532) is NOT usable: the Virtuals-sponsored wallet
# rejects the Sepolia ACP contract ("not on the sponsored allowlist", verified 2026-09-02).
ACP_CHAIN_ID=8453
BUILDER_CODE=

# ERC-8004 on Base mainnet. Reads use BASE_RPC_URL; giveFeedback goes through the buyer's ACP wallet.
BASE_RPC_URL=https://base-rpc.publicnode.com
ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
# Optional: provider wallet -> ERC-8004 agentId overrides, comma separated, e.g. 0xabc..=12,0xdef..=40
ERC8004_AGENT_IDS=

# ERC-8004 feedback signer: a plain EOA with a little ETH on Base. The sponsored smart wallet
# only calls allowlisted ACP contracts, so giveFeedback cannot go through it.
FEEDBACK_PRIVATE_KEY=0x
FEEDBACK_ADDRESS=0x

GRUDGE_MEMORY_URL=http://127.0.0.1:7411
